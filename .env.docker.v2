# Docker / K8s v2 部署（子路径 /movie-editor-v2，前后端同域）
# 现网 /movie-editor 不要用这份配置
VITE_APP_TYPE = tenant

VITE_USER_NODE_ENV = production

# 线上: https://api.highlands.ltd/movie-editor-v2
VITE_PUBLIC_PATH = /movie-editor-v2/

VITE_ROUTER_MODE = hash

VITE_BUILD_COMPRESS = none
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false
VITE_DROP_CONSOLE = true

# 容器内不建议启用 PWA（避免 Service Worker 缓存干扰发布）
VITE_PWA = false

# SaaS 主站 API（构建时可由 --build-arg 覆盖）
VITE_API_URL = https://ext.highlands.ltd/light-sass-api/

# 与后端同域子路径：/movie-editor-v2/api、/movie-editor-v2/uploads
VITE_EDITOR_SERVER_URL = /movie-editor-v2
VITE_EDITOR_FRONTEND_URL = /movie-editor-v2
